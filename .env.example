# Configurazione Halloween Guidizzolo (ZuccAmica)

# Porta del server (su Render/Railway/Fly.io viene assegnata automaticamente da process.env.PORT)
PORT=3000

# Nome del comune pilota e coordinate geografiche di partenza
TOWN_NAME=Guidizzolo
TOWN_PROVINCE=MN
CENTER_LAT=45.3188
CENTER_LNG=10.5828

# Raggio massimo in km per le registrazioni (evita spam fuori comune)
MAX_RADIUS_KM=8.0

# Password segreta per l'amministratore/moderatore del comune
ADMIN_KEY=cambia-questa-password

# Salt segreto per l'hashing dei PIN (cambialo in produzione)
SALT=cambia-questo-valore-segreto
